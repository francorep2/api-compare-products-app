# Base de datos (o DATABASE_URL completo)
DATABASE_URL=postgresql://appuser:change-me@localhost:5432/groceries
DB_SSLMODE=disable

# "dev" permite arrancar sin JWT_SECRET; en producción NO lo definas
APP_ENV=dev
# JWT: obligatorio en producción. Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Email (SendGrid)
USE_SENDGRID_API=1
SENDGRID_API_KEY=
MAIL_FROM=no-reply@example.com
SMTP_DRY_RUN=1
APP_NAME=Comparador Super
