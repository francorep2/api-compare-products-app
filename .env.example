# Base de datos (o DATABASE_URL completo)
DATABASE_URL=postgresql://appuser:change-me@localhost:5432/groceries
DB_SSLMODE=disable

# JWT (obligatorio cambiar en produccion)
JWT_SECRET=change-me
JWT_ALGORITHM=HS256

# Email (SendGrid)
USE_SENDGRID_API=1
SENDGRID_API_KEY=
MAIL_FROM=no-reply@example.com
SMTP_DRY_RUN=1
APP_NAME=Comparador Super
